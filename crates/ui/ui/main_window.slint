import { VerticalBox, ListView, Button } from "std-widgets.slint";

export struct GameModRow {
    name: string,
}

export component MainWindow inherits Window {
    in property <[GameModRow]> game-mods;
    in property <[string]> notices;
    in property <string> failure-summary;
    in property <[string]> failure-details;
    callback reload-requested();
    title: "Restall DB Manager";
    preferred-width: 800px;
    preferred-height: 600px;
    VerticalBox {
        HorizontalLayout {
            alignment: start;

            Button {
                text: "Reload";
                clicked => {
                    root.reload-requested();
                }
            }
        }

        HorizontalLayout {
            ListView {
                width: 240px;
                for game-mod in root.game-mods: Text {
                    text: game-mod.name;
                    overflow: elide;
                }
            }

            Rectangle { }
        }

        if root.failure-summary != "": Text {
            text: root.failure-summary;
            font-weight: 700;
            wrap: word-wrap;
        }
        if root.failure-details.length > 0: ListView {
            height: 120px;

            for detail in root.failure-details: Text {
                text: detail;
                wrap: word-wrap;
            }
        }
        if root.notices.length > 0: ListView {
            height: 120px;

            for notice in root.notices: Text {
                text: notice;
                wrap: word-wrap;
            }
        }
    }
}
